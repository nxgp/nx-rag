# Copy to .env and fill in environment variables.
# .env is gitignored. Never commit actual API keys or secrets to git.

# ---------------------------------------------------------------------------
# Core System & Environment
# ---------------------------------------------------------------------------
ENV=development                        # development | staging | production
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ---------------------------------------------------------------------------
# Vector Store (Qdrant - Single Shared Collection with Tenant Payload Isolation)
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                        # Required for Qdrant Cloud cluster
QDRANT_COLLECTION_NAME=mentera_chunks

# ---------------------------------------------------------------------------
# Embedding Providers (Bedrock | Azure | GCP)
# ---------------------------------------------------------------------------
DEFAULT_EMBEDDING_PROVIDER=bedrock      # bedrock | azure | gcp
DEFAULT_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
DEFAULT_EMBEDDING_DIMENSION=1024

# AWS Bedrock
AWS_REGION=us-east-1
AWS_PROFILE=default                    # Or provide AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=                 # e.g. https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# GCP Vertex AI
GCP_PROJECT_ID=                        # GCP project ID for Vertex AI
GCP_LOCATION=us-central1
GCP_EMBEDDING_MODEL=text-embedding-005

# ---------------------------------------------------------------------------
# Cloud Object Storage (Browser Direct Presigned Upload Architecture)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local                 # local | s3 | azure_blob | gcs
STORAGE_BUCKET=mentera-uploads
STORAGE_PREFIX=uploads/
UPLOAD_DIR=/tmp/mentera_uploads        # Local staging directory for download during ingestion
MAX_UPLOAD_SIZE_MB=100

# ---------------------------------------------------------------------------
# Ingestion, Chunking & Multi-Tenancy
# ---------------------------------------------------------------------------
DEFAULT_TENANT_ID=default
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# ---------------------------------------------------------------------------
# Observability & Experiment Tracking
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000

# ---------------------------------------------------------------------------
# API Server Configuration
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
