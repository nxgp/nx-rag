# Keep build context small and free of secrets.
.git
.gitignore
.github/
.venv/
venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Secrets and local state
.env
.env.*
!.env.example

# Data, indexes, experiment artifacts (mounted at runtime, not baked into images)
data/
experiments/
notebooks/
volumes/
mlruns/
mlflow.db

# Docs are not needed inside application images
docs/
*.md
!README.md
